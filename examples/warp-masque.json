{
  "_comment": "WARP over MASQUE: your own outbound is dialed through a panel config chosen by exit_when. Each user gets a WARP account (accounts.register creates it on their first request) and one endpoint from the list (the same one every time for the same user). Change exit_when to pick which panel configs are the exit; every other value is yours to edit.",
  "panel": {
    "url": "https://panel.example.com:2096/json/"
  },
  "accounts": {
    "file": "accounts.json",
    "register": {
      "enabled": true
    }
  },
  "chains": [
    {
      "id": "warp",
      "exit_when": {
        "remark": {
          "icontains": "fast"
        }
      },
      "choices": {
        "endpoint": [
          "162.159.198.114",
          "162.159.198.206",
          "162.159.198.186",
          "162.159.198.135",
          "162.159.198.219",
          "162.159.198.64",
          "162.159.198.231",
          "162.159.198.250",
          "162.159.198.184",
          "162.159.198.197",
          "162.159.198.48",
          "162.159.198.203",
          "162.159.198.230",
          "162.159.199.87",
          "162.159.199.127",
          "162.159.199.188",
          "162.159.199.163",
          "162.159.199.193",
          "162.159.199.102",
          "162.159.199.76",
          "162.159.199.192",
          "162.159.199.111",
          "162.159.199.113",
          "162.159.199.46",
          "162.159.199.109",
          "162.159.199.106",
          "162.159.199.101",
          "162.159.199.190",
          "162.159.199.235",
          "162.159.199.100",
          "162.159.199.83",
          "162.159.199.37",
          "162.159.199.149"
        ]
      },
      "entry": {
        "protocol": "masque",
        "settings": {
          "address": "{choice.endpoint}",
          "port": 443
        },
        "targetStrategy": "UseIPv4v6",
        "streamSettings": {
          "sockopt": {
            "domainStrategy": "UseIP",
            "happyEyeballs": {
              "tryDelayMs": 250,
              "prioritizeIPv6": false,
              "interleave": 2,
              "maxConcurrentTry": 20
            }
          },
          "method": "masque",
          "security": "tls",
          "tlsSettings": {
            "serverName": "www.cloudflare.com",
            "fingerprint": "ios",
            "alpn": [
              "h2"
            ]
          },
          "masqueSettings": {
            "warp": {
              "privateKey": "{account.privateKey}",
              "publicKey": "{account.publicKey}",
              "address": "{account.address}"
            }
          }
        }
      }
    }
  ]
}
